<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="2dp">

    <ImageView
        android:id="@+id/widget_bg_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="fitXY"
        android:src="@drawable/stillpoets_widget_preview_bg" />

    <LinearLayout
        android:id="@+id/widget_body"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="12dp"
        android:paddingEnd="14dp"
        android:paddingBottom="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/widget_dot"
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:contentDescription="@null"
                android:src="@drawable/stillpoets_widget_dot" />

            <TextView
                android:id="@+id/widget_tag"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:letterSpacing="0.08"
                android:maxLines="1"
                android:text="诗笺"
                android:textColor="#6B7069"
                android:textSize="10sp" />

            <ImageView
                android:id="@+id/widget_next_btn"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:contentDescription="@string/stillpoets_widget_next_cd"
                android:padding="5dp"
                android:scaleType="fitCenter"
                android:src="@drawable/stillpoets_ic_refresh" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:paddingTop="4dp"
            android:paddingBottom="6dp">

            <TextView
                android:id="@+id/widget_poem_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:ellipsize="end"
                android:fontFamily="serif"
                android:lineSpacingMultiplier="1.38"
                android:maxLines="4"
                android:text="@string/stillpoets_widget_empty_poem"
                android:textColor="#1F2320"
                android:textSize="15sp" />

            <ImageView
                android:id="@+id/widget_poem_image"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center_vertical"
                android:contentDescription="@null"
                android:scaleType="fitStart"
                android:visibility="gone" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_meta_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/stillpoets_widget_empty_meta"
                android:textColor="#6B7069"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/widget_hint_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:maxLines="1"
                android:text="读全诗 ›"
                android:textColor="#3A6B5C"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
