<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/stillpoets_widget_preview_bg"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="14dp"
        android:paddingEnd="16dp"
        android:paddingBottom="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:letterSpacing="0.08"
                android:maxLines="1"
                android:text="StillPoets · 诗笺"
                android:textColor="#3A6B5C"
                android:textSize="10sp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="serif"
            android:gravity="center_vertical"
            android:lineSpacingMultiplier="1.38"
            android:maxLines="3"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:text="诗歌、美丽、浪漫、爱情，&#10;才是我们活着的意义。"
            android:textColor="#1F2320"
            android:textSize="15sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:maxLines="1"
                android:text="《死亡诗社》 · 约翰·基汀"
                android:textColor="#6B7069"
                android:textSize="11sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="读全诗 ›"
                android:textColor="#3A6B5C"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
